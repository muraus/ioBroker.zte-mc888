{
  "name": "iobroker.zte-mc888",
  "version": "0.0.3",
  "description": "ioBroker adapter to read LTE/5G signal values from a ZTE MC888 router",
  "author": {
    "name": "Stefan"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muraus/ioBroker.zte-mc888.git"
  },
  "bugs": {
    "url": "https://github.com/muraus/ioBroker.zte-mc888/issues"
  },
  "homepage": "https://github.com/muraus/ioBroker.zte-mc888",
  "keywords": [
    "ioBroker",
    "ZTE",
    "MC888",
    "LTE",
    "5G",
    "modem",
    "router",
    "signal"
  ],
  "main": "main.js",
  "files": [
    "admin/",
    "lib/",
    "io-package.json",
    "main.js",
    "zte-mc888.png",
    "LICENSE",
    "README.md",
    "!lib/**/*.test.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.1"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "glob": "^13.0.0"
  },
  "scripts": {
    "test:js": "mocha --config test/mocharc.custom.json \"lib/**/*.test.js\" \"test/**/*.test.js\"",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:js && npm run test:package",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint -c eslint.config.mjs .",
    "lint:fix": "eslint -c eslint.config.mjs . --fix",
    "translate": "translate-adapter",
    "release": "release-script"
  },
  "readmeFilename": "README.md"
}
