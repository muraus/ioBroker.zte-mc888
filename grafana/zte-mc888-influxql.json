    {
      "id": 1,
      "type": "stat",
      "title": "Verbindung",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": {
              "true": { "text": "Online", "color": "green", "index": 0 },
              "false": { "text": "Offline", "color": "red", "index": 1 },
              "1": { "text": "Online", "color": "green", "index": 2 },
              "0": { "text": "Offline", "color": "red", "index": 3 }
            }}
          ],
          "color": { "mode": "fixed", "fixedColor": "text" },
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "last", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "SELECT last(\"value\") FROM \"$instance.info.connection\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "table"
        }
      ]
    },
